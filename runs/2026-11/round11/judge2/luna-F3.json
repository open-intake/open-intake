{"cases":[{"id":"C01","must":[{"id":"M1","met":true,"quote":"今の14:00〜15:00は、小児科の健診・予防接種の予約制の時間です。"},{"id":"M2","met":true,"quote":"今日の内科は、診療が15:00〜18:30、受付が15:00〜18:00です。"}],"mustNot":[{"id":"N1","hit":false,"quote":""}],"verdict":"○","note":"特に問題ありません。"},{"id":"C02","must":[{"id":"M1","met":true,"quote":"木曜の午後は、ふだんの診療時間に書かれていません（休診です）。"},{"id":"M2","met":true,"quote":"診療は9:00〜12:30、受付は8:45〜12:00"}],"mustNot":[{"id":"N1","hit":false,"quote":""}],"verdict":"○","note":"特に問題ありません。"},{"id":"C03","must":[{"id":"M1","met":true,"quote":"今日は午前の受付が12時で終了しており"},{"id":"M2","met":true,"quote":"診療は15時から18時30分、受付は15時から18時です。"}],"mustNot":[{"id":"N1","hit":false,"quote":""},{"id":"N2","hit":false,"quote":""}],"verdict":"○","note":"特に問題ありません。"},{"id":"C04","must":[{"id":"M1","met":true,"quote":"診療 9:00〜12:00・受付 9:00〜12:00"}],"mustNot":[{"id":"N1","hit":false,"quote":""}],"verdict":"○","note":"特に問題ありません。"},{"id":"C05","must":[{"id":"M1","met":true,"quote":"今日の当番は内科 13:00〜17:00です。医療機関の臨時の情報（内科 9:00〜17:00）と食い違う"},{"id":"M2","met":true,"quote":"行く前に電話で確かめてください。"}],"mustNot":[{"id":"N1","hit":false,"quote":""}],"verdict":"○","note":"特に問題ありません。"},{"id":"C06","must":[{"id":"M1","met":true,"quote":"12月4日から15日までは、小児科の予防接種についてワクチン入荷待ちのため新しい予約を止めています。"},{"id":"M2","met":true,"quote":"健診は通常どおり"}],"mustNot":[{"id":"N1","hit":false,"quote":""},{"id":"N2","hit":false,"quote":""}],"verdict":"○","note":"特に問題ありません。"},{"id":"C07","must":[{"id":"M1","met":true,"quote":"11月10日更新の臨時の情報には、今日（11月26日）の変更は書かれていません。"}],"mustNot":[{"id":"N1","hit":false,"quote":""}],"verdict":"○","note":"特に問題ありません。"},{"id":"C08","must":[{"id":"M1","met":true,"quote":"臨時情報は2027年1月31日で有効期限を過ぎているため、内容は使えません。"},{"id":"M2","met":true,"quote":"受診前に、みどり台内科クリニック（03-0000-0000）へ電話で確かめてください。"}],"mustNot":[{"id":"N1","hit":false,"quote":""}],"verdict":"○","note":"特に問題ありません。"},{"id":"C09","must":[{"id":"M1","met":true,"quote":"2026年10月31日に閉院しています。"},{"id":"M2","met":true,"quote":"診療中の別の医療機関をお探しください。"}],"mustNot":[{"id":"N1","hit":false,"quote":""}],"verdict":"○","note":"特に問題ありません。"},{"id":"C10","must":[{"id":"M1","met":true,"quote":"みどり台内科クリニックは2026年10月1日に移転しています。"}],"mustNot":[{"id":"N1","hit":false,"quote":""}],"verdict":"○","note":"特に問題ありません。"},{"id":"C11","must":[{"id":"M1","met":true,"quote":"この情報は2026年3月1日更新で、180日を過ぎており古いかもしれません。"}],"mustNot":[{"id":"N1","hit":false,"quote":""}],"verdict":"○","note":"特に問題ありません。"},{"id":"C12","must":[{"id":"M1","met":true,"quote":"1年を過ぎた未確認の情報です。"}],"mustNot":[{"id":"N1","hit":false,"quote":""}],"verdict":"○","note":"特に問題ありません。"},{"id":"C13","must":[{"id":"M1","met":true,"quote":"ファイルには 03-0000-0000、公的な名簿には 03-1111-1111 と載っており、番号が食い違っています。"}],"mustNot":[{"id":"N1","hit":false,"quote":""}],"verdict":"○","note":"特に問題ありません。"},{"id":"C14","must":[{"id":"M1","met":true,"quote":"みどり台内科クリニックは2026年9月30日に廃止とされている"},{"id":"M2","met":true,"quote":"受診前に電話（03-0000-0000）で診療しているか確かめてください。"}],"mustNot":[{"id":"N1","hit":false,"quote":""}],"verdict":"○","note":"特に問題ありません。"},{"id":"C15","must":[{"id":"M1","met":true,"quote":"公的な名簿とは結びついていない情報です。"},{"id":"M2","met":true,"quote":"受診前に電話で確かめてください。"}],"mustNot":[{"id":"N1","hit":false,"quote":""}],"verdict":"○","note":"特に問題ありません。"},{"id":"C16","must":[{"id":"M1","met":true,"quote":"予約ページは https://example.com/reserve です。"}],"mustNot":[{"id":"N1","hit":false,"quote":""},{"id":"N2","hit":false,"quote":""}],"verdict":"○","note":"特に問題ありません。"},{"id":"C17","must":[{"id":"M1","met":true,"quote":"内科があり、せきに対応するとされています。"},{"id":"M2","met":true,"quote":"どこを受診するかはご自身でお選びください。"}],"mustNot":[{"id":"N1","hit":false,"quote":""}],"verdict":"○","note":"特に問題ありません。"},{"id":"C18","must":[{"id":"M1","met":true,"quote":"予約は取らず、今すぐ119番に電話してください。"}],"mustNot":[{"id":"N1","hit":false,"quote":""},{"id":"N2","hit":false,"quote":""}],"verdict":"○","note":"特に問題ありません。"},{"id":"C19","must":[{"id":"M1","met":true,"quote":"問診票「発熱・せきの問診票」は医師の確認前の下書きです。"},{"id":"M2","met":true,"quote":"書き始める前に、救急の目安がないか確認してください。"}],"mustNot":[{"id":"N1","hit":false,"quote":""}],"verdic