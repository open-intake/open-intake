{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-intake.github.io/open-intake/schema/clinic-directory.schema.json",
  "title": "Open Intake clinic-directory.json v0.3 (draft)",
  "description": "地域の一覧（医師会・自治体・有志が、地域で clinic-intake.json を掲示している医療機関をまとめた索引）と、地域の当番表",
  "type": "object",
  "required": [
    "spec",
    "specVersion",
    "updated",
    "publisher",
    "area",
    "entries"
  ],
  "properties": {
    "spec": {
      "const": "open-intake-directory"
    },
    "specVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "policy": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            }
          }
        }
      ]
    },
    "publisher": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "area": {
      "type": "object",
      "required": [
        "addressCountry"
      ],
      "properties": {
        "addressCountry": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "addressRegion": {
          "type": "string"
        },
        "addressLocality": {
          "type": "string"
        }
      }
    },
    "note": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "identifiers": {
            "description": "識別番号（v0.3 から）。system は URI か、仕様の表にある名前（jp-medical-institution-code など）",
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "system",
                "value"
              ],
              "properties": {
                "system": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "geo": {
            "type": "object",
            "required": [
              "latitude",
              "longitude"
            ],
            "properties": {
              "latitude": {
                "type": "number"
              },
              "longitude": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "onCall": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "name",
          "opens",
          "closes"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "kind": {
            "enum": [
              "holiday",
              "night",
              "other"
            ]
          },
          "opens": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "closes": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
