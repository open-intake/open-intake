{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-intake.github.io/open-intake/schema/clinic-schedule.schema.json",
  "title": "Open Intake clinic-schedule.json v0.2 (draft)",
  "description": "臨時の情報（臨時の休診・診療時間の変更、担当医の予定、当番、お知らせ）。日付の前後や期限切れは作成サイトの検査で見る。",
  "type": "object",
  "required": [
    "spec",
    "specVersion",
    "updated",
    "validUntil"
  ],
  "properties": {
    "spec": {
      "const": "open-intake-schedule"
    },
    "specVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "validUntil": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "status"
        ],
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "status": {
            "enum": [
              "closed",
              "open",
              "changed"
            ]
          },
          "hours": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "opens",
                "closes"
              ],
              "properties": {
                "opens": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "closes": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                }
              }
            }
          },
          "note": {
            "type": "string"
          },
          "department": {
            "type": "string",
            "minLength": 1,
            "description": "当てはまる診療科（v0.4 から）"
          },
          "service": {
            "type": "array",
            "description": "当てはまる用途（v0.4 から）。general・checkup・vaccination・procedure・rehabilitation・other。知らない値は読む側が無視する",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reception": {
            "type": "object",
            "description": "受付の始まりと締め切り（v0.4 から）。片方だけでもよい",
            "properties": {
              "opens": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "closes": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "note": {
                "type": "string"
              }
            }
          },
          "entry": {
            "enum": [
              "walk-in",
              "appointment",
              "none"
            ],
            "description": "受け付け方（v0.4 から）。none は新しい受付をしない時間で、休診ではない"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "open",
                    "changed"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "hours"
              ],
              "properties": {
                "hours": {
                  "type": "array",
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "doctorSchedule": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "opens",
          "closes"
        ],
        "anyOf": [
          {
            "required": [
              "department"
            ]
          },
          {
            "required": [
              "name"
            ]
          }
        ],
        "oneOf": [
          {
            "required": [
              "days"
            ]
          },
          {
            "required": [
              "date"
            ]
          }
        ],
        "properties": {
          "department": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "days": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "Mo",
                "Tu",
                "We",
                "Th",
                "Fr",
                "Sa",
                "Su",
                "PH"
              ]
            }
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "opens": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "closes": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "from": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "onCall": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "kind",
          "opens",
          "closes"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "kind": {
            "enum": [
              "holiday",
              "night",
              "other"
            ]
          },
          "opens": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "closes": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "department": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      }
    },
    "main": {
      "type": "string",
      "description": "メインのファイル（clinic-intake.json）のありか。読む側は、メインの files にこのファイルが載っているかを確かめる"
    },
    "policy": {
      "description": "使用目的と使い方の決まり（SPEC §1b）。url（決まりの場所）と summary（要点）",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
